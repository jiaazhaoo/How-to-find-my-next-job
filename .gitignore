# The workspace holds redacted excerpts, the alias vault and your cards.
# None of it belongs in git -- the vault least of all.
workspace/
*.tmp

# Your real config names clients and project code names. Only the example
# file is tracked.
config/sources.json

# Build artefacts. These were committed by a `git add -A` and then blocked
# everyone else's `git pull`, because pip regenerates them locally and git
# saw the incoming deletion as a conflict.
*.egg-info/
build/
dist/
.eggs/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store
