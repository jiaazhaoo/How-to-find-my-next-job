{
  "sources": [
    "~/code/my-project",
    "~/Documents/reports"
  ],
  "authors": [
    "Your Name",
    "you@example.com"
  ],
  "since": null,
  "budget_tokens": 120000,
  "pack_tokens": 25000,
  "excerpt_cap": 3000,
  "keep_pii_reversible": true,
  "pseudonymize_git_identities": true,
  "sensitive_terms": [
    {
      "term": "Acme Corp",
      "label": "ORG"
    },
    {
      "term": "北极星计划",
      "label": "PROJECT"
    }
  ],
  "allowlist": [
    "example.com",
    "localhost"
  ],
  "per_source_share": 0.35,
  "connectors": {
    "claude-code": {
      "enabled": true,
      "min_human_chars": 200
    },
    "codex": {
      "enabled": true,
      "min_human_chars": 200
    },
    "notion-export": {
      "enabled": true,
      "path": null,
      "min_relevance": 0.35
    },
    "x-archive": {
      "enabled": true,
      "path": null,
      "min_relevance": 0.35
    }
  },
  "topic_policy": {
    "enabled_for": [
      "chat",
      "notes",
      "public"
    ],
    "drop_ratio": 0.5,
    "extra_topics": {}
  }
}
